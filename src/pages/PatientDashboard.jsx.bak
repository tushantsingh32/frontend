import React, { useEffect, useState } from "react";

export default function PatientDashboard(){
  const [records, setRecords] = useState([]);
  const [email, setEmail] = useState("");

  useEffect(()=>{
    try {
      const stored = localStorage.getItem("mp_user");
      if (stored) {
        const u = JSON.parse(stored);
        setEmail(u.email || "");
        fetchRecords(u.email || "");
      }
    } catch {
      // do nothing
    }
  },[]);

  const fetchRecords = (patientEmail) => {
    if (!patientEmail) return;
    fetch("http://localhost:5000/api/records/" + encodeURIComponent(patientEmail))
      .then(r=>r.json()).then(d=>setRecords(d.records || []))
      .catch(e=>console.error(e));
  };

  return (
    <div className="min-h-screen p-8 bg-sky-50">
      <div className="max-w-5xl mx-auto">
        <h2 className="text-2xl font-bold mb-4">Your Medical Records</h2>
        {records.length === 0 && <div className="p-4 bg-white rounded shadow">You have no records yet.</div>}
        <div className="grid gap-4 mt-4">
          {records.map(r => (
            <div key={r.id} className="p-4 bg-white rounded shadow">
              <div className="font-semibold">{r.originalName}</div>
              <div className="text-sm text-slate-600">Uploaded: {new Date(r.createdAt).toLocaleString()} — Verified: {r.verified ? "Yes" : "No"}</div>
              {r.ipfsCid && <a href={"https://dweb.link/ipfs/"+r.ipfsCid} target="_blank" rel="noreferrer" className="text-sky-600 text-sm">View on IPFS</a>}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
